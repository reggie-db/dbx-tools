{
  "openapi": "3.1.0",
  "info": {
    "title": "dbx-tools model proxy",
    "version": "0.9.13"
  },
  "paths": {
    "/api/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "list_models",
        "parameters": [
          {
            "in": "query",
            "name": "extended",
            "description": "Include dbx-tools capability metadata in each model record.",
            "schema": {
              "description": "Include dbx-tools capability metadata in each model record.",
              "type": "boolean",
              "default": false
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "search",
            "description": "Filter or fuzzy-rank the live model catalogue.",
            "schema": {
              "description": "Filter or fuzzy-rank the live model catalogue.",
              "type": [
                "string",
                "null"
              ]
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": true
              }
            }
          }
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "operationId": "embeddings",
        "requestBody": {
          "description": "Protocol-specific JSON request body.",
          "content": {
            "application/json": {
              "schema": true
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Protocol response returned as JSON or a raw event stream.",
            "content": {
              "application/json": {
                "schema": true
              },
              "text/event-stream": {
                "schema": true
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "chat_completions",
        "requestBody": {
          "description": "Protocol-specific JSON request body.",
          "content": {
            "application/json": {
              "schema": true
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Protocol response returned as JSON or a raw event stream.",
            "content": {
              "application/json": {
                "schema": true
              },
              "text/event-stream": {
                "schema": true
              }
            }
          }
        }
      }
    },
    "/v1/responses": {
      "post": {
        "operationId": "responses",
        "requestBody": {
          "description": "Protocol-specific JSON request body.",
          "content": {
            "application/json": {
              "schema": true
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Protocol response returned as JSON or a raw event stream.",
            "content": {
              "application/json": {
                "schema": true
              },
              "text/event-stream": {
                "schema": true
              }
            }
          }
        }
      }
    },
    "/v1/messages": {
      "post": {
        "operationId": "anthropic_messages",
        "requestBody": {
          "description": "Protocol-specific JSON request body.",
          "content": {
            "application/json": {
              "schema": true
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Protocol response returned as JSON or a raw event stream.",
            "content": {
              "application/json": {
                "schema": true
              },
              "text/event-stream": {
                "schema": true
              }
            }
          }
        }
      }
    },
    "/api/auth": {
      "get": {
        "operationId": "auth_status",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatusResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "auth_switch",
        "requestBody": {
          "description": "Profile source accepted by the runtime manager.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuntimeSelection"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSwitchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/profiles": {
      "get": {
        "operationId": "auth_profiles",
        "parameters": [
          {
            "in": "query",
            "name": "refresh",
            "description": "Re-read the Databricks configuration file before listing profiles.",
            "schema": {
              "description": "Re-read the Databricks configuration file before listing profiles.",
              "type": "boolean",
              "default": false
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfilesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rate-limits/models/{model}/cancel-waits": {
      "post": {
        "operationId": "cancel_model_waits",
        "parameters": [
          {
            "in": "path",
            "name": "model",
            "required": true,
            "schema": {
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelWaitsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rate-limits/models/{model}/retry-now": {
      "post": {
        "operationId": "retry_model_now",
        "parameters": [
          {
            "in": "path",
            "name": "model",
            "required": true,
            "schema": {
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetryNowResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthProfilesQuery": {
        "type": "object",
        "properties": {
          "refresh": {
            "description": "Re-read the Databricks configuration file before listing profiles.",
            "type": "boolean",
            "default": false
          }
        }
      },
      "AuthStatusResponse": {
        "type": "object",
        "properties": {
          "controlsEnabled": {
            "description": "Whether same-origin loopback control routes are enabled.",
            "type": "boolean"
          },
          "runtime": {
            "description": "Current secret-free Databricks runtime status.",
            "allOf": [
              {
                "$ref": "#/components/schemas/RuntimeStatus"
              }
            ]
          }
        },
        "required": [
          "controlsEnabled",
          "runtime"
        ]
      },
      "AuthSwitchResponse": {
        "type": "object",
        "properties": {
          "runtime": {
            "description": "Newly committed secret-free Databricks runtime status.",
            "allOf": [
              {
                "$ref": "#/components/schemas/RuntimeStatus"
              }
            ]
          }
        },
        "required": [
          "runtime"
        ]
      },
      "CancelModelWaitsPath": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          }
        },
        "required": [
          "model"
        ]
      },
      "CancelWaitsResponse": {
        "type": "object",
        "properties": {
          "cancelledWaiters": {
            "description": "Total token-capacity and cooldown waiters cancelled.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "capacityWaiters": {
            "description": "Cancelled token-capacity waiters.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "cooldownWaiters": {
            "description": "Cancelled cooldown waiters.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "matchedCooldownKeys": {
            "description": "Cooldown keys matched for the model.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "model": {
            "description": "Resolved model whose waits were cancelled.",
            "type": "string"
          }
        },
        "required": [
          "model",
          "capacityWaiters",
          "cooldownWaiters",
          "matchedCooldownKeys",
          "cancelledWaiters"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "generation": {
            "description": "Active immutable runtime generation.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "status": {
            "description": "Health state for the running proxy.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "generation"
        ]
      },
      "ModelsQuery": {
        "type": "object",
        "properties": {
          "extended": {
            "description": "Include dbx-tools capability metadata in each model record.",
            "type": "boolean",
            "default": false
          },
          "search": {
            "description": "Filter or fuzzy-rank the live model catalogue.",
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PersistenceMode": {
        "description": "Runtime persistence selected for service-owned state.",
        "oneOf": [
          {
            "description": "Use memory for direct execution and SQLite for installed services.",
            "type": "string",
            "const": "auto"
          },
          {
            "description": "Keep state only for the lifetime of the process.",
            "type": "string",
            "const": "memory"
          },
          {
            "description": "Persist state in the service configuration directory.",
            "type": "string",
            "const": "sqlite"
          }
        ]
      },
      "ProfileAuthKind": {
        "type": "string",
        "enum": [
          "user-to-machine",
          "machine-to-machine",
          "personal-access-token",
          "app-service-principal",
          "app-on-behalf-of"
        ]
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "accountId": {
            "description": "Account identifier associated with the profile.",
            "type": [
              "string",
              "null"
            ]
          },
          "authKind": {
            "description": "Authentication kind inferred without returning credential values.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProfileAuthKind"
              }
            ]
          },
          "host": {
            "description": "Configured workspace or accounts host.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "Databricks CLI profile name.",
            "type": "string"
          },
          "target": {
            "description": "Target inferred from the configured host and account metadata.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProfileTarget"
              }
            ]
          },
          "workspaceId": {
            "description": "Workspace identifier associated with the profile.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "target",
          "authKind"
        ]
      },
      "ProfileTarget": {
        "type": "string",
        "enum": [
          "workspace",
          "account",
          "unified"
        ]
      },
      "ProfilesResponse": {
        "type": "object",
        "properties": {
          "profiles": {
            "description": "Secret-free configured Databricks profiles.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileResponse"
            }
          }
        },
        "required": [
          "profiles"
        ]
      },
      "RetryModelNowPath": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          }
        },
        "required": [
          "model"
        ]
      },
      "RetryNowResponse": {
        "type": "object",
        "properties": {
          "matchedCooldownKeys": {
            "description": "Cooldown keys matched for the model.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "model": {
            "description": "Resolved model whose cooldowns were released.",
            "type": "string"
          },
          "releasedCooldowns": {
            "description": "Active cooldowns released immediately.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "model",
          "matchedCooldownKeys",
          "releasedCooldowns"
        ]
      },
      "RuntimeSelection": {
        "description": "Profile source accepted by the runtime manager.",
        "oneOf": [
          {
            "description": "Resolve the normal ambient Databricks authentication chain.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "ambient"
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "description": "Resolve one exact named Databricks CLI profile.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "profile"
              },
              "profile": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "profile"
            ]
          }
        ]
      },
      "RuntimeStatus": {
        "description": "Secret-free status for one committed runtime generation.",
        "type": "object",
        "properties": {
          "authKind": {
            "description": "Secret-free authentication kind label.",
            "type": "string"
          },
          "generation": {
            "description": "Monotonic runtime generation identifier.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "host": {
            "description": "Resolved Databricks workspace or account host.",
            "type": "string"
          },
          "persistence": {
            "description": "Persistence mode used for service settings and aggregate metrics.",
            "allOf": [
              {
                "$ref": "#/components/schemas/PersistenceMode"
              }
            ]
          },
          "profile": {
            "description": "Resolved Databricks CLI profile name.",
            "type": "string"
          },
          "selection": {
            "description": "Requested source used to resolve Databricks authentication.",
            "allOf": [
              {
                "$ref": "#/components/schemas/RuntimeSelection"
              }
            ]
          },
          "switchingEnabled": {
            "description": "Whether this process permits runtime profile switching.",
            "type": "boolean"
          },
          "workspaceId": {
            "description": "Resolved workspace identifier when configured.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "generation",
          "selection",
          "profile",
          "host",
          "authKind",
          "persistence",
          "switchingEnabled"
        ]
      }
    }
  }
}