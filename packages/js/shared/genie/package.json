{
  "name": "@dbx-tools/shared-genie",
  "description": "Browser-safe Genie schemas, event vocabulary, and snapshot diff helpers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reggie-db/dbx-tools.git",
    "directory": "packages/js/shared/genie"
  },
  "scripts": {},
  "devDependencies": {
    "@databricks/sdk-experimental": "catalog:",
    "@types/bun": "1.3.14",
    "@types/node": "^24.6.0",
