{
  "manifestVersion": 3,
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "bunx tauri build --features desktop"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "npx projen default",
          "cwd": "../../.."
        }
      ]
    },
    "dev": {
      "name": "dev",
      "description": "Run the native development runtime",
      "steps": [
        {
          "exec": "bunx tauri dev --features desktop-codegen"
        }
      ]
    },
    "format": {
      "name": "format",
      "description": "Format Rust sources",
      "steps": [
        {
          "exec": "cargo fmt"
        }
      ]
    },
    "format:check": {
      "name": "format:check",
      "description": "Check Rust source formatting",
      "steps": [
        {
          "exec": "cargo fmt -- --check"
        }
      ]
    },
    "lint": {
      "name": "lint",
      "description": "Lint every Rust target and feature",
      "steps": [
        {
          "exec": "cargo clippy --all-targets --all-features"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "exec": "cargo package"
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "exec": "cargo test"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"npx projen\"."
}
