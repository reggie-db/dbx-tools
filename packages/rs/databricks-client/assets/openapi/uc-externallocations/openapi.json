        "operationId": "externalLocations.listExternalLocations",
        "parameters": [
          {
            "in": "query",
            "name": "include_browse",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "includeBrowse"
          },
          {
            "in": "query",
            "name": "include_unbound",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "includeUnbound"
          },
          {
            "in": "query",
            "name": "max_results",
