            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "maxResults"
          },
          {
            "in": "query",
            "name": "page_token",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "pageToken"
