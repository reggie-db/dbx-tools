  "paths": {
    "/api/3.0/rfa/destinations": {
      "patch": {
        "description": "Updates the access request destinations for the given securable.\nThe caller must be a metastore admin, the owner of the securable, or a user that has the **MANAGE** privilege on the securable in order to assign destinations.\nA maximum of 5 emails and 5 external notification destinations (Slack, Microsoft Teams, and Generic Webhook destinations) can be assigned to a securable.\nIf a URL destination is assigned, no other destinations can be set.\n\nThe supported securable types are: \"metastore\", \"catalog\", \"schema\", \"table\",\n\"external_location\", \"connection\", \"credential\", \"function\", \"registered_model\", and \"volume\".",
        "operationId": "rfa.updateAccessRequestDestinations",
        "parameters": [
          {
            "in": "query",
            "name": "update_mask",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "updateMask"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessRequestDestinations"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestDestinations"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "rfa"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/3.0/rfa/destinations/{securableType}/{fullName}": {
      "get": {
        "description": "Gets an array of access request destinations for the specified securable.\nAny caller can see URL destinations or the destinations on the metastore.\nOtherwise, only those with **BROWSE** permissions on the securable can see destinations.\n\nThe supported securable types are: \"metastore\", \"catalog\", \"schema\", \"table\",\n\"external_location\", \"connection\", \"credential\", \"function\", \"registered_model\", and \"volume\".",
        "operationId": "rfa.getAccessRequestDestinations",
        "parameters": [
          {
            "in": "path",
            "name": "fullName",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "fullName"
          },
          {
            "in": "path",
            "name": "securableType",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "securableType"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestDestinations"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "rfa"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/3.0/rfa/requests": {
      "post": {
        "description": "Creates access requests for Unity Catalog permissions for a specified principal on a securable object.\nThis Batch API can take in multiple principals, securable objects,\nand permissions as the input and returns the access request destinations for each.\nPrincipals must be unique across the API call.\n\nThe supported securable types are: \"metastore\", \"catalog\", \"schema\", \"table\",\n\"external_location\", \"connection\", \"credential\", \"function\", \"registered_model\", and \"volume\".",
        "operationId": "rfa.batchCreateAccessRequests",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "requests": {
                    "items": {
                      "$ref": "#/components/schemas/CreateAccessRequest"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchCreateAccessRequestsResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "rfa"
        ],
        "x-databricks-api-scope": "workspace"
      }
    }
  },
