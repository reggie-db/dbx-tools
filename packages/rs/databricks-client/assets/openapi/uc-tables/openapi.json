  "info": {
    "title": "Tables API",
    "version": "0.49.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/2.1/unity-catalog/constraints": {
      "post": {
        "description": "Creates a new table constraint.\n\nFor the table constraint creation to succeed, the user must satisfy both of these conditions:\n- the user must have the **USE_CATALOG** privilege on the table's parent catalog,\nthe **USE_SCHEMA** privilege on the table's parent schema, and be the owner of the table.\n- if the new constraint is a __ForeignKeyConstraint__,\nthe user must have the **USE_CATALOG** privilege on the referenced parent table's catalog,\nthe **USE_SCHEMA** privilege on the referenced parent table's schema,\nand be the owner of the referenced parent table.",
        "operationId": "tables.createTableConstraint",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "constraint": {
                    "$ref": "#/components/schemas/TableConstraint"
                  },
                  "full_name_arg": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TableConstraint"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "tables"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.1/unity-catalog/constraints/{fullNameArg}": {
      "delete": {
        "description": "Deletes a table constraint.\n\nFor the table constraint deletion to succeed, the user must satisfy both of these conditions:\n- the user must have the **USE_CATALOG** privilege on the table's parent catalog,\nthe **USE_SCHEMA** privilege on the table's parent schema, and be the owner of the table.\n- if __cascade__ argument is **true**, the user must have the following permissions on all of the child tables:\nthe **USE_CATALOG** privilege on the table's catalog,\nthe **USE_SCHEMA** privilege on the table's schema,\nand be the owner of the table.",
        "operationId": "tables.deleteTableConstraint",
        "parameters": [
          {
            "in": "path",
            "name": "fullNameArg",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "fullNameArg"
          },
          {
            "in": "query",
            "name": "cascade",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "cascade"
          },
          {
            "in": "query",
            "name": "constraint_name",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "constraintName"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteTableConstraintResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "tables"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.1/unity-catalog/table-summaries": {
      "get": {
        "description": "Gets an array of summaries for tables for a schema and catalog within the metastore. The table summaries returned are either:\n\n* summaries for tables (within the current metastore and parent catalog and schema), when the user is a metastore admin, or:\n* summaries for tables and schemas (within the current metastore and parent catalog)\nfor which the user has ownership or the **SELECT** privilege on the table and ownership or **USE_SCHEMA** privilege on the schema,\nprovided that the user also has ownership or the **USE_CATALOG** privilege on the parent catalog.\n\nThere is no guarantee of a specific ordering of the elements in the array.\n\nPAGINATION BEHAVIOR: The API is by default paginated, a page may contain zero results while still providing a next_page_token.\nClients must continue reading pages until next_page_token is absent, which is the only indication that the end of results has been reached.",
        "operationId": "tables.listTableSummaries",
        "parameters": [
          {
            "in": "query",
            "name": "catalog_name",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "catalogName"
          },
          {
            "in": "query",
            "name": "include_manifest_capabilities",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "includeManifestCapabilities"
          },
          {
            "in": "query",
            "name": "max_results",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "maxResults"
          },
          {
            "in": "query",
            "name": "page_token",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "pageToken"
          },
          {
            "in": "query",
            "name": "schema_name_pattern",
            "required": false,
            "schema": {
