            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteRegisteredModelResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "registeredModels"
        ],
        "x-databricks-api-scope": "workspace"
      },
      "get": {
        "description": "Get a registered model.\n\nThe caller must be a metastore admin or an owner of (or have the **EXECUTE**\nprivilege on) the registered model. For the latter case, the caller must also be the owner\nor have the **USE_CATALOG** privilege on the parent catalog and the **USE_SCHEMA** privilege\non the parent schema.",
        "operationId": "registeredModels.getRegisteredModel",
        "parameters": [
          {
            "in": "path",
            "name": "fullNameArg",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "fullNameArg"
          },
          {
            "in": "query",
            "name": "include_aliases",
            "required": false,
