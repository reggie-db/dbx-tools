                  "schema_name": {
                    "type": "string"
                  },
                  "storage_location": {
                    "type": "string"
                  },
                  "updated_at": {
                    "format": "int64",
                    "type": "integer"
                  },
                  "updated_by": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredModelInfo"
                }
              }
