  "info": {
    "title": "Registered Models API",
    "version": "0.49.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/2.1/unity-catalog/models": {
      "get": {
        "description": "List registered models. You can list registered models under a particular schema,\nor list all registered models in the current metastore.\n\nThe returned models are filtered based on the privileges of the calling user.\nFor example, the metastore admin is able to list all the registered models.\nA regular user needs to be the owner or have the **EXECUTE** privilege\non the registered model to receive the registered models in the response.\nFor the latter case, the caller must also be the owner or have the **USE_CATALOG**\nprivilege on the parent catalog and the **USE_SCHEMA** privilege on the parent schema.\n\nThere is no guarantee of a specific ordering of the elements in the response.\n\nPAGINATION BEHAVIOR: The API is by default paginated, a page may contain zero results while still providing a next_page_token.\nClients must continue reading pages until next_page_token is absent, which is the only indication that the end of results has been reached.",
        "operationId": "registeredModels.listRegisteredModels",
        "parameters": [
          {
            "in": "query",
            "name": "catalog_name",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "catalogName"
          },
          {
            "in": "query",
            "name": "include_browse",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "includeBrowse"
          },
          {
            "in": "query",
            "name": "max_results",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "maxResults"
          },
          {
            "in": "query",
            "name": "page_token",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "pageToken"
          },
          {
            "in": "query",
            "name": "schema_name",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "schemaName"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListRegisteredModelsResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "registeredModels"
        ],
        "x-databricks-api-scope": "workspace"
      },
      "post": {
        "description": "Creates a new registered model in Unity Catalog.\n\nFile storage for model versions in the registered model\nwill be located in the default location which is specified by the parent schema,\nor the parent catalog, or the Metastore.\n\nFor registered model creation to succeed, the user must satisfy the following conditions:\n- The caller must be a metastore admin, or be the owner of the parent catalog and schema,\nor have the **USE_CATALOG** privilege on the parent catalog\nand the **USE_SCHEMA** privilege on the parent schema.\n- The caller must have the **CREATE MODEL** or **CREATE FUNCTION** privilege on the parent schema.",
        "operationId": "registeredModels.createRegisteredModel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "aliases": {
                    "items": {
                      "$ref": "#/components/schemas/RegisteredModelAliasInfo"
                    },
                    "type": "array"
                  },
                  "browse_only": {
                    "type": "boolean"
                  },
                  "catalog_name": {
                    "type": "string"
                  },
                  "comment": {
                    "type": "string"
                  },
                  "created_at": {
                    "format": "int64",
                    "type": "integer"
                  },
                  "created_by": {
                    "type": "string"
                  },
                  "full_name": {
                    "type": "string"
                  },
                  "metastore_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "schema_name": {
                    "type": "string"
                  },
                  "storage_location": {
                    "type": "string"
                  },
                  "updated_at": {
                    "format": "int64",
                    "type": "integer"
                  },
                  "updated_by": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredModelInfo"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "registeredModels"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.1/unity-catalog/models/{fullNameArg}": {
      "delete": {
        "description": "Deletes a registered model and all its model versions from the specified parent catalog and schema.\n\nThe caller must be a metastore admin or an owner of the registered model.\nFor the latter case, the caller must also be the owner or have the **USE_CATALOG**\nprivilege on the parent catalog and the **USE_SCHEMA** privilege on the parent schema.",
        "operationId": "registeredModels.deleteRegisteredModel",
        "parameters": [
          {
            "in": "path",
            "name": "fullNameArg",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "fullNameArg"
          }
        ],
        "responses": {
