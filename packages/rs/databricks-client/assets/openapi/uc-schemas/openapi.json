                    "type": "string"
                  },
                  "full_name": {
                    "type": "string"
                  },
                  "metastore_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "options": {
                    "$ref": "#/components/schemas/Schema_745ddacd"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "properties": {
                    "$ref": "#/components/schemas/Schema_745ddacd"
                  },
                  "schema_id": {
                    "type": "string"
                  },
                  "storage_location": {
                    "type": "string"
                  },
                  "storage_root": {
                    "type": "string"
                  },
                  "updated_at": {
                    "format": "int64",
                    "type": "integer"
                  },
                  "updated_by": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaInfo"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "schemas"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.1/unity-catalog/schemas/{fullNameArg}": {
      "delete": {
        "description": "Deletes the specified schema from the parent catalog.\nThe caller must be the owner of the schema or an owner of the parent catalog.",
        "operationId": "schemas.deleteSchema",
        "parameters": [
          {
