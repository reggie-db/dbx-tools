    "/api/2.1/accounts/{accountId}/settings-metadata": {
      "get": {
        "description": "List valid setting keys and metadata. These settings are available to be referenced via\nGET :method:settingsv2/getpublicaccountsetting and\nPATCH :method:settingsv2/patchpublicaccountsetting APIs",
        "operationId": "settings.listAccountSettingsMetadata",
        "parameters": [
          {
            "in": "path",
            "name": "accountId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "accountId"
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "pageSize"
          },
          {
            "in": "query",
            "name": "page_token",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "pageToken"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListAccountSettingsMetadataResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "settings"
        ],
        "x-databricks-api-scope": "account"
      }
    },
