      "get": {
        "description": "The GetQuota API returns usage information for a single resource quota, defined as a\nchild-parent pair. This API also refreshes the quota count if it is out of date.\nRefreshes are triggered asynchronously. The updated count might not be returned in the first call.",
        "operationId": "resourceQuotas.getQuota",
        "parameters": [
          {
            "in": "path",
            "name": "parentFullName",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "parentFullName"
          },
          {
            "in": "path",
            "name": "parentSecurableType",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "parentSecurableType"
          },
          {
            "in": "path",
            "name": "quotaName",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "quotaName"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetQuotaResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "resourceQuotas"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.1/unity-catalog/resource-quotas/all-resource-quotas": {
      "get": {
        "description": "ListQuotas returns all quota values under the metastore. There are no SLAs on the freshness of the counts\nreturned. This API does not trigger a refresh of quota counts.\n\nPAGINATION BEHAVIOR: The API is by default paginated, a page may contain zero results while still providing a next_page_token.\nClients must continue reading pages until next_page_token is absent, which is the only indication that the end of results has been reached.",
        "operationId": "resourceQuotas.listQuotas",
        "parameters": [
          {
            "in": "query",
            "name": "max_results",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "maxResults"
          },
          {
            "in": "query",
            "name": "page_token",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "pageToken"
