                "schema": {
                  "$ref": "#/components/schemas/AddInstanceProfileResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "instanceProfiles"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/instance-profiles/edit": {
      "post": {
        "description": "The only supported field to change is the optional IAM role ARN associated with\nthe instance profile. It is required to specify the IAM role ARN if both of\nthe following are true:\n\n* Your role name and instance profile name do not match. The name is the part\nafter the last slash in each ARN.\n* You want to use the instance profile with [Databricks SQL Serverless](/sql/admin/serverless.html).\n\nTo understand where these fields are in the AWS console, see\n[Enable serverless SQL warehouses](/sql/admin/serverless.html).\n\nThis API is only available to admin users.",
        "operationId": "instanceProfiles.editInstanceProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "iam_role_arn": {
                    "type": "string"
                  },
                  "instance_profile_arn": {
                    "type": "string"
                  },
                  "is_meta_instance_profile": {
                    "type": "boolean"
                  }
                },
                "type": "object"
