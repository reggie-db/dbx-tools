            "x-databricks-sdk-name": "objectType"
          },
          {
            "in": "query",
            "name": "update_mask",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "updateMask"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
