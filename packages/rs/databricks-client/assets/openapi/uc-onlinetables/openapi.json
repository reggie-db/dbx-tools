      "post": {
        "description": "Create a new Online Table.",
        "operationId": "onlineTables.createOnlineTable",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OnlineTable"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnlineTable"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "onlineTables"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/online-tables/{name}": {
      "delete": {
        "description": "Delete an online table.\nWarning: This will delete all the data in the online table. If the source Delta table was\ndeleted or modified since this Online Table was created, this will lose the data forever!",
        "operationId": "onlineTables.deleteOnlineTable",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "name"
          }
        ],
        "responses": {
          "204": {
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "onlineTables"
        ],
        "x-databricks-api-scope": "workspace"
      },
      "get": {
        "description": "Get information about an existing online table and its status.",
        "operationId": "onlineTables.getOnlineTable",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
