  "info": {
    "title": "Query History API",
    "version": "0.49.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/2.0/sql/history/queries": {
      "get": {
        "description": "List the history of queries through SQL warehouses, and serverless compute.\n\nYou can filter by user ID, warehouse ID, status, and time range.\nMost recently started queries are returned first (up to max_results in request).\nThe pagination token returned in response can be used to list subsequent query statuses.",
        "operationId": "queryHistory.listQueries",
        "parameters": [
          {
            "in": "query",
            "name": "include_metrics",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "includeMetrics"
          },
          {
            "in": "query",
            "name": "max_results",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "maxResults"
          },
          {
            "in": "query",
            "name": "page_token",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "pageToken"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListQueriesResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "queryHistory"
        ],
        "x-databricks-api-scope": "workspace"
      }
    }
  },
