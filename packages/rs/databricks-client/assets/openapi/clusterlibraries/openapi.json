  "info": {
    "title": "Cluster Libraries API",
    "version": "0.49.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/2.0/libraries/all-cluster-statuses": {
      "get": {
        "description": "Get the status of all libraries on all clusters. A status is returned for all libraries installed on this cluster\nvia the API or the libraries UI.",
        "operationId": "clusterLibraries.allClusterStatuses",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListAllClusterLibraryStatusesResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "clusterLibraries"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/libraries/cluster-status": {
      "get": {
        "description": "Get the status of libraries on a cluster. A status is returned for all libraries installed on this cluster via the API\nor the libraries UI.\nThe order of returned libraries is as follows:\n1. Libraries set to be installed on this cluster, in the order that the libraries were added\nto the cluster, are returned first.\n2. Libraries that were previously requested to be installed on this cluster or,\nbut are now marked for removal, in no particular order, are returned last.",
        "operationId": "clusterLibraries.clusterStatus",
        "parameters": [
          {
            "in": "query",
            "name": "cluster_id",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "clusterId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterLibraryStatuses"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "clusterLibraries"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/libraries/install": {
      "post": {
        "description": "Add libraries to install on a cluster. The installation is asynchronous; it happens in\nthe background after the completion of this request.",
        "operationId": "clusterLibraries.installLibraries",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UninstallLibrariesRequest"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallLibrariesResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "clusterLibraries"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/libraries/uninstall": {
      "post": {
        "description": "Set libraries to uninstall from a cluster. The libraries won't be uninstalled until\nthe cluster is restarted. A request to uninstall a library that is not currently installed is ignored.",
        "operationId": "clusterLibraries.uninstallLibraries",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UninstallLibrariesRequest"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UninstallLibrariesResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "clusterLibraries"
        ],
        "x-databricks-api-scope": "workspace"
      }
    }
  },
