                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      },
      "head": {
        "description": "Get the metadata of a directory. The response HTTP headers contain the metadata.\nThere is no response body.\n\nThis method is useful to check if a directory exists and the caller has access to it.\n\nIf you wish to ensure the directory exists, you can instead use `PUT`, which will create\nthe directory if it does not exist, and is idempotent (it will succeed if the directory\nalready exists).",
        "operationId": "files.getDirectoryMetadata",
        "parameters": [
          {
            "in": "path",
            "name": "directoryPath",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "directoryPath"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDirectoryMetadataResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      },
      "put": {
        "description": "Creates an empty directory. If necessary, also creates any parent directories of the\nnew, empty directory (like the shell command `mkdir -p`). If called on an existing\ndirectory, returns a success response; this method is idempotent (it will succeed if the directory already\nexists).",
        "operationId": "files.createDirectory",
        "parameters": [
          {
            "in": "path",
            "name": "directoryPath",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "directoryPath"
          }
        ],
        "responses": {
