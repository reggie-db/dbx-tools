  "info": {
    "title": "Files API",
    "version": "0.49.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/2.0/dbfs/add-block": {
      "post": {
        "description": "Appends a block of data to the stream specified by the input handle. If the handle does not\nexist, this call will throw an exception with ``RESOURCE_DOES_NOT_EXIST``.\n\nIf the block of data exceeds 1 MB, this call will throw an exception with ``MAX_BLOCK_SIZE_EXCEEDED``.",
        "operationId": "files.addBlock",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "data": {
                    "format": "byte",
                    "type": "string"
                  },
                  "handle": {
                    "format": "int64",
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddBlockResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/dbfs/close": {
      "post": {
        "description": "Closes the stream specified by the input handle. If the handle does not exist, this call\nthrows an exception with ``RESOURCE_DOES_NOT_EXIST``.",
        "operationId": "files.close",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "handle": {
                    "format": "int64",
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloseResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/dbfs/create": {
      "post": {
        "description": "Opens a stream to write to a file and returns a handle to this stream.\nThere is a 10 minute idle timeout on this handle. If a file or directory already exists on the given path\nand __overwrite__ is set to false, this call will throw an exception with ``RESOURCE_ALREADY_EXISTS``.\n\nA typical workflow for file upload would be:\n\n1. Issue a ``create`` call and get a handle.\n2. Issue one or more ``add-block`` calls with the handle you have.\n3. Issue a ``close`` call with the handle you have.",
        "operationId": "files.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "overwrite": {
                    "type": "boolean"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/dbfs/delete": {
      "post": {
        "description": "Delete the file or directory (optionally recursively delete all files in the directory).\nThis call throws an exception with `IO_ERROR` if the path is a non-empty directory and `recursive` is set to\n`false` or on other similar errors.\n\nWhen you delete a large number of files, the delete operation is done in increments. The call returns\na response after approximately 45 seconds with an error message (503 Service Unavailable) asking you to\nre-invoke the delete operation until the directory structure is fully deleted.\n\nFor operations that delete more than 10K files, we discourage using the DBFS REST API, but advise you to\nperform such operations in the context of a cluster, using\nthe [File system utility (dbutils.fs)](/dev-tools/databricks-utils.html#dbutils-fs). `dbutils.fs`\ncovers the functional scope of the DBFS REST API, but from notebooks. Running such operations using notebooks\nprovides better control and manageability, such as selective deletes, and the possibility to automate periodic\ndelete jobs.",
        "operationId": "files.delete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "recursive": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/dbfs/get-status": {
      "get": {
        "description": "Gets the file information for a file or directory.\nIf the file or directory does not exist, this call throws an exception with `RESOURCE_DOES_NOT_EXIST`.",
        "operationId": "files.getStatus",
        "parameters": [
          {
            "in": "query",
            "name": "path",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "path"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStatusResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/dbfs/list": {
      "get": {
        "description": "List the contents of a directory, or details of the file. If the file or directory does not exist, this call\nthrows an exception with `RESOURCE_DOES_NOT_EXIST`.\n\nWhen calling list on a large directory, the list operation will time out after approximately 60 seconds.\nWe strongly recommend using list only on directories containing less than 10K files and discourage using\nthe DBFS REST API for operations that list more than 10K files. Instead, we recommend that you perform such\noperations in the context of a cluster, using\nthe [File system utility (dbutils.fs)](/dev-tools/databricks-utils.html#dbutils-fs), which provides the same\nfunctionality without timing out.",
        "operationId": "files.list",
        "parameters": [
          {
            "in": "query",
            "name": "path",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "path"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListStatusResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/dbfs/mkdirs": {
      "post": {
        "description": "Creates the given directory and necessary parent directories if they do not exist.\nIf a file (not a directory) exists at any prefix of the input path, this call throws an exception with `RESOURCE_ALREADY_EXISTS`.\n**Note**: If this operation fails, it might have succeeded in creating some of the necessary parent directories.",
        "operationId": "files.mkdirs",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MkDirsResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/dbfs/move": {
      "post": {
        "description": "Moves a file from one location to another location within DBFS.\nIf the source file does not exist, this call throws an exception with `RESOURCE_DOES_NOT_EXIST`.\nIf a file already exists in the destination path, this call throws an exception with `RESOURCE_ALREADY_EXISTS`.\nIf the given source path is a directory, this call always recursively moves all files.",
        "operationId": "files.move",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "destination_path": {
                    "type": "string"
                  },
                  "source_path": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/dbfs/put": {
      "post": {
        "description": "Uploads a file through the use of multipart form post.\nIt is mainly used for streaming uploads, but can also be used as a convenient single call for data upload.\n\nAlternatively you can pass contents as base64 string.\n\nThe amount of data that can be passed (when not streaming) using the __contents__  parameter is limited to 1 MB.\n`MAX_BLOCK_SIZE_EXCEEDED` will be thrown if this limit is exceeded.\n\nIf you want to upload large files, use the streaming upload. For details, see :method:dbfs/create,\n:method:dbfs/addBlock, :method:dbfs/close.",
        "operationId": "files.put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "contents": {
                    "format": "byte",
                    "type": "string"
                  },
                  "overwrite": {
                    "type": "boolean"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PutResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/dbfs/read": {
      "get": {
        "description": "Returns the contents of a file. If the file does not exist, this call throws an exception with `RESOURCE_DOES_NOT_EXIST`.\nIf the path is a directory, the read length is negative, or if the offset is negative, this call throws an exception with\n`INVALID_PARAMETER_VALUE`. If the read length exceeds 1 MB, this call throws an\nexception with `MAX_READ_SIZE_EXCEEDED`.\n\nIf `offset + length` exceeds the number of bytes in a file, it reads the contents until the end of file.",
        "operationId": "files.read",
        "parameters": [
          {
            "in": "query",
            "name": "length",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "length"
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "offset"
          },
          {
            "in": "query",
            "name": "path",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "path"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.0/fs/directories{directoryPath}": {
      "delete": {
        "description": "Deletes an empty directory.\n\nTo delete a non-empty directory, first delete all of its contents. This can be done\nby listing the directory contents and deleting each file and subdirectory recursively.",
        "operationId": "files.deleteDirectory",
        "parameters": [
          {
            "in": "path",
            "name": "directoryPath",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "directoryPath"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteDirectoryResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "files"
        ],
        "x-databricks-api-scope": "workspace"
      },
      "get": {
        "description": "Returns the contents of a directory.\nIf there is no directory at the specified path, the API returns an HTTP 404 error.",
        "operationId": "files.listDirectoryContents",
        "parameters": [
          {
            "in": "path",
            "name": "directoryPath",
            "required": true,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "directoryPath"
          },
          {
            "in": "query",
            "name": "page_size",
