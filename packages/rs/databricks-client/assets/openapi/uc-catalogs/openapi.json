    "/api/2.1/unity-catalog/catalogs": {
      "get": {
        "description": "Gets an array of catalogs in the metastore.\nIf the caller is the metastore admin, all catalogs will be retrieved.\nOtherwise, only catalogs owned by the caller (or for which the caller has the **USE_CATALOG** privilege) will be retrieved.\nThere is no guarantee of a specific ordering of the elements in the array.\n\nNOTE: we recommend using max_results=0 to use the paginated version of this API. Unpaginated calls will be deprecated soon.\n\nPAGINATION BEHAVIOR: When using pagination (max_results >= 0), a page may contain zero results while still providing a next_page_token.\nClients must continue reading pages until next_page_token is absent, which is the only indication that the end of results has been reached.",
        "operationId": "catalogs.listCatalogs",
        "parameters": [
          {
            "in": "query",
            "name": "include_browse",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "includeBrowse"
          },
          {
            "in": "query",
            "name": "include_unbound",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "includeUnbound"
          },
          {
            "in": "query",
            "name": "max_results",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "maxResults"
          },
          {
            "in": "query",
            "name": "page_token",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "pageToken"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListCatalogsResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "catalogs"
        ],
        "x-databricks-api-scope": "workspace"
      },
