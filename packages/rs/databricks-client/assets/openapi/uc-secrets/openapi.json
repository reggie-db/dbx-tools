              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Secret"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "secrets"
        ],
        "x-databricks-api-scope": "workspace"
      }
    },
    "/api/2.1/unity-catalog/secrets/{fullName}": {
      "delete": {
        "description": "Deletes a secret by its three-level (fully qualified) name.\n\nYou must be the owner of the secret or a metastore admin.",
        "operationId": "secrets.deleteSecret",
        "parameters": [
          {
            "in": "path",
            "name": "fullName",
            "required": true,
            "schema": {
              "type": "string"
            },
