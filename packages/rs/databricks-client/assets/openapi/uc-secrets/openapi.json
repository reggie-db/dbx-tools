    "/api/2.1/unity-catalog/secrets": {
      "get": {
        "description": "Lists secrets in Unity Catalog.\n\nYou must be a metastore admin, the owner of the secret, or have the\n**MANAGE** privilege on the secret.\n\nBoth **catalog_name** and **schema_name** must be specified together to filter secrets within\na specific schema. Results are paginated; use the **page_token** field from the response\nto retrieve subsequent pages.",
        "operationId": "secrets.listSecrets",
        "parameters": [
          {
            "in": "query",
            "name": "catalog_name",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "catalogName"
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "pageSize"
          },
          {
            "in": "query",
            "name": "page_token",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "pageToken"
          },
          {
            "in": "query",
            "name": "schema_name",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-databricks-sdk-name": "schemaName"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListSecretsResponse"
                }
              }
            },
            "description": "Operation completed successfully."
          }
        },
        "tags": [
          "secrets"
        ],
        "x-databricks-api-scope": "workspace"
      },
      "post": {
        "description": "Creates a new secret in Unity Catalog.\n\nYou must be the owner of the parent schema or have the **CREATE_SECRET** and **USE SCHEMA**\nprivileges on the parent schema and **USE CATALOG** on the parent catalog.\n\nThe secret is stored in the specified catalog and schema, and the **value** field\ncontains the sensitive data to be securely stored.",
        "operationId": "secrets.createSecret",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Secret"
              }
            }
          },
          "required": false
        },
        "responses": {
