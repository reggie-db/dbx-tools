{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbx.tools/schemas/polyglot-fixture.json",
  "title": "dbx-tools polyglot fixture document",
  "description": "A fixture suite or directory default. Defaults may omit tests and are merged from the fixture root down.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative path or URL for this polyglot fixture schema."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable compatibility contract covered by this suite or default."
    },
    "modules": {
      "$ref": "#/$defs/runtimeModules",
      "description": "Default import module for each runtime."
    },
    "functions": {
      "type": "object",
      "description": "Named targets and their shared parity cases.",
      "additionalProperties": { "$ref": "#/$defs/functionDefinition" }
    },
    "tests": {
      "type": "array",
      "description": "Top-level cases that select their targets explicitly.",
      "items": { "$ref": "#/$defs/testCase" }
    }
  },
  "anyOf": [{ "required": ["modules"] }, { "required": ["functions"] }, { "required": ["tests"] }],
  "additionalProperties": false,
  "$defs": {
    "runtimeModules": {
      "type": "object",
      "description": "Runtime-specific module specifiers.",
      "properties": {
        "typescript": {
          "type": "string",
          "minLength": 1,
          "description": "TypeScript module specifier imported by Bun."
        },
        "python": {
          "type": "string",
          "minLength": 1,
          "description": "Python module imported by importlib."
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "runtimeStringOverride": {
      "description": "One shared string or separate runtime-specific values.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "properties": {
            "typescript": { "type": "string", "minLength": 1 },
            "python": { "type": "string", "minLength": 1 }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      ]
    },
    "invokeModes": {
      "type": "object",
      "description": "How each runtime reads or invokes the resolved target.",
      "properties": {
        "typescript": { "enum": ["positional", "optionsFirst", "value"] },
        "python": { "enum": ["positional", "keywordOptions", "value"] }
      },
      "additionalProperties": false
    },
    "resultModes": {
      "type": "object",
      "description": "Optional normalization applied before comparing results.",
      "properties": {
        "typescript": { "enum": ["identity", "camelKeys", "string"] },
        "python": { "enum": ["identity", "camelKeys", "string"] }
      },
      "additionalProperties": false
    },
    "targetOverrides": {
      "type": "object",
      "properties": {
        "module": {
          "$ref": "#/$defs/runtimeStringOverride",
          "description": "Module override for this function or case."
        },
        "path": {
          "$ref": "#/$defs/runtimeStringOverride",
          "description": "Dot-separated export or attribute path."
        },
        "invoke": {
          "$ref": "#/$defs/invokeModes",
          "description": "Invocation override, including value reads for constants."
        },
        "result": {
          "$ref": "#/$defs/resultModes",
          "description": "Result normalization override."
        }
      }
    },
    "testCase": {
      "description": "One cross-runtime input and expected result or error.",
      "allOf": [
        { "$ref": "#/$defs/targetOverrides" },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Short test name shown by the parity runner."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Why this case is part of the compatibility contract."
            },
            "function": {
              "type": "string",
              "minLength": 1,
              "description": "Named function definition inherited by this case."
            },
            "args": { "type": "array", "description": "Positional arguments." },
            "options": {
              "type": "object",
              "description": "TypeScript options-first or Python keyword arguments."
            },
            "expected": { "description": "Expected normalized result." },
            "error": {
              "type": "string",
              "minLength": 1,
              "description": "Expected runtime error class name."
            }
          },
          "oneOf": [{ "required": ["expected"] }, { "required": ["error"] }]
        }
      ],
      "unevaluatedProperties": false
    },
    "functionDefinition": {
      "description": "A logical cross-runtime target with optional inherited cases.",
      "allOf": [
        { "$ref": "#/$defs/targetOverrides" },
        {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Compatibility rule represented by this target."
            },
            "tests": {
              "type": "array",
              "minItems": 1,
              "description": "Cases executed against this target.",
              "items": { "$ref": "#/$defs/testCase" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
