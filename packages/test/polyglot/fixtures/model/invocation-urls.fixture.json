{
  "$schema": "../../schema.json",
  "modules": {
    "typescript": "@dbx-tools/model",
    "python": "dbx_tools.model"
  },
  "functions": {
    "invocationsUrl": {
      "path": { "typescript": "invoke.invocationsUrl", "python": "invocations_url" },
      "tests": [
        {
          "name": "invocations url",
          "args": ["https://workspace.example.com/", "team/model name"],
          "expected": "https://workspace.example.com/serving-endpoints/team%2Fmodel%20name/invocations"
        }
      ]
    },
    "responsesUrl": {
      "path": { "typescript": "invoke.responsesUrl", "python": "responses_url" },
      "tests": [
        {
          "name": "responses url",
          "args": ["https://workspace.example.com"],
          "expected": "https://workspace.example.com/serving-endpoints/responses"
        }
      ]
    },
    "openResponsesUrl": {
      "path": { "typescript": "invoke.openResponsesUrl", "python": "open_responses_url" },
      "tests": [
        {
          "name": "open responses url",
          "args": ["https://workspace.example.com/"],
          "expected": "https://workspace.example.com/serving-endpoints/open-responses"
        }
      ]
    },
    "chatCompletionsUrl": {
      "path": { "typescript": "invoke.chatCompletionsUrl", "python": "chat_completions_url" },
      "tests": [
        {
          "name": "chat completions url",
          "args": ["https://workspace.example.com/"],
          "expected": "https://workspace.example.com/serving-endpoints/chat/completions"
        }
      ]
    },
    "responsesUpstreamUrl": {
      "path": { "typescript": "invoke.responsesUpstreamUrl", "python": "responses_upstream_url" },
      "tests": [
        {
          "name": "responses upstream gpt",
          "args": ["https://workspace.example.com/", "databricks-gpt-5"],
          "expected": "https://workspace.example.com/serving-endpoints/responses"
        },
        {
          "name": "responses upstream claude",
          "args": ["https://workspace.example.com/", "databricks-claude-sonnet-4-6"],
          "expected": "https://workspace.example.com/serving-endpoints/open-responses"
        }
      ]
    }
  }
}
