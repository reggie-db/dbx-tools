{
  "root": "core",
  "cases": [
    {
      "name": "fnv default length",
      "function": "fnvHash",
      "args": ["string:7:billing"],
      "expected": "1m8m64"
    },
    {
      "name": "fnv joined stable keys",
      "function": "fnvHash",
      "args": ["string:7:billing\u0000string:4:prod"],
      "expected": "091p2g"
    },
    {
      "name": "fnv maximum digest length",
      "function": "fnvHash",
      "args": ["string:7:billing"],
      "options": { "length": 7 },
      "expected": "1m8m64b"
    },
    {
      "name": "fnv zero length",
      "function": "fnvHash",
      "args": ["billing"],
      "options": { "length": 0 },
      "expected": ""
    },
    {
      "name": "stable null",
      "function": "toStableKey",
      "args": [null],
      "expected": "null"
    },
    {
      "name": "stable string uses utf16 length",
      "function": "toStableKey",
      "args": ["😀"],
      "expected": "string:2:😀"
    },
    {
      "name": "stable type tags",
      "function": "toStableKey",
      "args": ["1"],
      "expected": "string:1:1"
    },
    {
      "name": "stable number",
      "function": "toStableKey",
      "args": [1],
      "expected": "number:1"
    },
    {
      "name": "stable negative zero",
      "function": "toStableKey",
      "args": [{ "$type": "negativeZero" }],
      "expected": "number:-0"
    },
    {
      "name": "stable array boundaries",
      "function": "toStableKey",
      "args": [["a", "bc"]],
      "expected": "array:[string:1:a,string:2:bc]"
    },
    {
      "name": "stable array order",
      "function": "toStableKey",
      "args": [[2, 1]],
      "expected": "array:[number:2,number:1]"
    },
    {
      "name": "stable object key order",
      "function": "toStableKey",
      "args": [{ "b": 2, "a": 1 }],
      "expected": "object:{string:1:a=number:1,string:1:b=number:2}"
    },
    {
      "name": "stable set order",
      "function": "toStableKey",
      "args": [{ "$type": "set", "values": [2, 1] }],
      "expected": "set:[number:1,number:2]"
    },
    {
      "name": "stable cycle error",
      "function": "toStableKey",
      "args": [{ "$type": "cycle" }],
      "error": "TypeError"
    },
    {
      "name": "stable non-finite error",
      "function": "toStableKey",
      "args": [{ "$type": "nan" }],
      "error": "TypeError"
    },
    {
      "name": "identifier multiple values",
      "function": "toIdentifier",
      "args": ["billing", "Prod"],
      "expected": "billing-prod"
    },
    {
      "name": "identifier camel case",
      "function": "toIdentifier",
      "args": ["myApp"],
      "expected": "my-app"
    },
    {
      "name": "identifier acronym boundary",
      "function": "toIdentifier",
      "args": ["XMLHttpRequest"],
      "expected": "xml-http-request"
    },
    {
      "name": "identifier punctuation",
      "function": "toIdentifier",
      "args": ["already_snake"],
      "expected": "already-snake"
    }
  ]
}
