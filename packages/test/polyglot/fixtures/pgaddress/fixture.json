{
  "$schema": "../../schema.json",
  "functions": {
    "parseAddress": {
      "tests": [
        { "name": "null address", "args": [null], "expected": {} },
        { "name": "empty address", "args": [""], "expected": {} },
        { "name": "whitespace address", "args": ["   "], "expected": {} },
        { "name": "unrecognized address", "args": ["Not An Address"], "expected": {} },
        {
          "name": "postgres uri",
          "args": [
            "postgresql://me%40acme.com@ep-1.database.eastus2.azuredatabricks.net:5433/app%20db?sslmode=disable"
          ],
          "expected": {
            "host": "ep-1.database.eastus2.azuredatabricks.net",
            "port": 5433,
            "user": "me@acme.com",
            "database": "app db",
            "sslMode": "disable"
          }
        },
        {
          "name": "camel-case ssl mode",
          "args": ["postgres://h.example.com/db?sslMode=PrEfEr"],
          "expected": { "host": "h.example.com", "database": "db", "sslMode": "prefer" }
        },
        {
          "name": "unsupported ssl mode",
          "args": ["postgres://h.example.com/db?sslmode=verify-full"],
          "expected": { "host": "h.example.com", "database": "db" }
        },
        {
          "name": "endpoint resource",
          "args": ["projects/demo/branches/production/endpoints/ep-1"],
          "expected": {
            "project": "demo",
            "branch": "production",
            "endpointId": "ep-1",
            "endpoint": "projects/demo/branches/production/endpoints/ep-1"
          }
        },
        {
          "name": "database resource",
          "args": ["projects/demo/branches/production/databases/databricks-postgres"],
          "expected": {
            "project": "demo",
            "branch": "production",
            "databaseResourceId": "databricks-postgres"
          }
        },
        {
          "name": "project resource",
          "args": ["projects/demo"],
          "expected": { "project": "demo" }
        },
        {
          "name": "branch resource",
          "args": ["projects/demo/branches/main"],
          "expected": { "project": "demo", "branch": "main" }
        },
        { "name": "malformed resource", "args": ["projects/demo/branches"], "expected": {} },
        {
          "name": "hostname",
          "args": ["ep-1.database.azuredatabricks.net"],
          "expected": { "host": "ep-1.database.azuredatabricks.net" }
        },
        {
          "name": "project id",
          "args": ["dbx-tools-demo"],
          "expected": { "project": "dbx-tools-demo" }
        }
      ]
    },
    "parseResourcePath": {
      "tests": [
        { "name": "resource parser rejects branch id", "args": ["production"], "expected": {} },
        { "name": "resource parser null", "args": [null], "expected": {} },
        {
          "name": "resource parser branch",
          "args": ["projects/demo/branches/main"],
          "expected": { "project": "demo", "branch": "main" }
        }
      ]
    }
  }
}
