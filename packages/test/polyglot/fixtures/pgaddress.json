{
  "root": "pgaddress",
  "cases": [
    {
      "name": "null address",
      "expected": {},
      "function": "parseAddress",
      "args": [null]
    },
    {
      "name": "empty address",
      "expected": {},
      "function": "parseAddress",
      "args": [""]
    },
    {
      "name": "whitespace address",
      "expected": {},
      "function": "parseAddress",
      "args": ["   "]
    },
    {
      "name": "unrecognized address",
      "expected": {},
      "function": "parseAddress",
      "args": ["Not An Address"]
    },
    {
      "name": "postgres uri",
      "expected": {
        "host": "ep-1.database.eastus2.azuredatabricks.net",
        "port": 5433,
        "user": "me@acme.com",
        "database": "app db",
        "sslMode": "disable"
      },
      "function": "parseAddress",
      "args": [
        "postgresql://me%40acme.com@ep-1.database.eastus2.azuredatabricks.net:5433/app%20db?sslmode=disable"
      ]
    },
    {
      "name": "camel-case ssl mode",
      "expected": {
        "host": "h.example.com",
        "database": "db",
        "sslMode": "prefer"
      },
      "function": "parseAddress",
      "args": ["postgres://h.example.com/db?sslMode=PrEfEr"]
    },
    {
      "name": "unsupported ssl mode",
      "expected": {
        "host": "h.example.com",
        "database": "db"
      },
      "function": "parseAddress",
      "args": ["postgres://h.example.com/db?sslmode=verify-full"]
    },
    {
      "name": "endpoint resource",
      "expected": {
        "project": "demo",
        "branch": "production",
        "endpointId": "ep-1",
        "endpoint": "projects/demo/branches/production/endpoints/ep-1"
      },
      "function": "parseAddress",
      "args": ["projects/demo/branches/production/endpoints/ep-1"]
    },
    {
      "name": "database resource",
      "expected": {
        "project": "demo",
        "branch": "production",
        "databaseResourceId": "databricks-postgres"
      },
      "function": "parseAddress",
      "args": ["projects/demo/branches/production/databases/databricks-postgres"]
    },
    {
      "name": "project resource",
      "expected": {
        "project": "demo"
      },
      "function": "parseAddress",
      "args": ["projects/demo"]
    },
    {
      "name": "branch resource",
      "expected": {
        "project": "demo",
        "branch": "main"
      },
      "function": "parseAddress",
      "args": ["projects/demo/branches/main"]
    },
    {
      "name": "malformed resource",
      "expected": {},
      "function": "parseAddress",
      "args": ["projects/demo/branches"]
    },
    {
      "name": "hostname",
      "expected": {
        "host": "ep-1.database.azuredatabricks.net"
      },
      "function": "parseAddress",
      "args": ["ep-1.database.azuredatabricks.net"]
    },
    {
      "name": "project id",
      "expected": {
        "project": "dbx-tools-demo"
      },
      "function": "parseAddress",
      "args": ["dbx-tools-demo"]
    },
    {
      "name": "resource parser rejects branch id",
      "expected": {},
      "function": "parseResourcePath",
      "args": ["production"]
    },
    {
      "name": "resource parser null",
      "expected": {},
      "function": "parseResourcePath",
      "args": [null]
    },
    {
      "name": "resource parser branch",
      "expected": {
        "project": "demo",
        "branch": "main"
      },
      "function": "parseResourcePath",
      "args": ["projects/demo/branches/main"]
    }
  ]
}
