{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(bun --eval \"console.log(process.env.PATH)\")"
  },
  "tasks": {
    "appkit:sync": {
      "name": "appkit:sync",
      "description": "Synchronize installed AppKit plugin metadata",
      "steps": [
        {
          "exec": "appkit plugin sync --write --silent"
        }
      ]
    },
    "appkit:typegen": {
      "name": "appkit:typegen",
      "description": "Generate AppKit client declarations",
      "steps": [
        {
          "exec": "appkit generate-types"
        }
      ]
    },
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "tsc -p tsconfig.server.json --noEmit"
        },
        {
          "exec": "tsc -p tsconfig.client.json --noEmit"
        },
        {
          "exec": "bun build.ts"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "bunx projen default",
          "cwd": "../.."
        }
      ]
    },
    "dev": {
      "name": "dev",
      "description": "Run the AppKit server in development mode",
      "env": {
        "NODE_ENV": "development"
      },
      "steps": [
        {
          "exec": "bun --watch server/server.ts",
          "receiveArgs": true
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)"
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile"
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "execArgs": [
            "mkdir",
            "-p",
            "dist/js"
          ]
        },
        {
          "execArgs": [
            "npm",
            "pack",
            "--pack-destination",
            "dist/js",
            "--ignore-scripts"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "start": {
      "name": "start",
      "description": "Run the AppKit server in production mode",
      "env": {
        "NODE_ENV": "production"
      },
      "steps": [
        {
          "exec": "bun server/server.ts",
          "receiveArgs": true
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "exec": "bun test server/test --pass-with-no-tests"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watch & compile in the background",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--build",
            "-w"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"bunx projen\"."
}
