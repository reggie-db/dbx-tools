{
  "releaseRustVersion": "stable",
  "usesCargoLock": true,
  "bindings": [
    {
      "crate": "dbx-tools-core",
      "rust": "packages/rs/core",
      "node": "packages/js/node/core-rs",
      "nodePackage": "@dbx-tools/core-rs",
      "python": "packages/py/core-rs",
      "pythonPackage": "dbx-tools-core-rs",
      "pythonModule": "dbx_tools.core_rs"
    },
    {
      "crate": "dbx-tools-google",
      "dependencies": [
        "dbx-tools-core"
      ],
      "rust": "packages/rs/google",
      "node": "packages/js/node/google-rs",
      "nodePackage": "@dbx-tools/google-rs",
      "python": "packages/py/google-rs",
      "pythonPackage": "dbx-tools-google-rs",
      "pythonModule": "dbx_tools.google_rs"
    },
    {
      "crate": "dbx-tools-model",
      "dependencies": [
        "dbx-tools-core"
      ],
      "rust": "packages/rs/model",
      "node": "packages/js/node/model-rs",
      "nodePackage": "@dbx-tools/model-rs",
      "python": "",
      "pythonPackage": ""
    }
  ],
  "binaries": [
    {
      "crate": "dbx-tools-lakebase-proxy",
      "binary": "dbx-lakebase-proxy",
      "excludedOs": [
        "win32"
      ],
      "requiredFeatures": []
    },
    {
      "crate": "dbx-tools-model-proxy",
      "binary": "dbx-model-proxy",
      "excludedOs": [],
      "requiredFeatures": []
    },
    {
      "crate": "dbx-tools-model-proxy",
      "binary": "dbx-model-proxy-tray",
      "excludedOs": [],
      "requiredFeatures": [
        "tray"
      ]
    }
  ],
  "targets": [
    {
      "runner": "ubuntu-22.04",
      "cargo": "x86_64-unknown-linux-gnu",
      "node": "linux-x64-gnu",
      "python": "manylinux_2_35_x86_64",
      "os": "linux",
      "cpu": "x64",
      "libc": "glibc",
      "glibcVersion": "2.35",
      "packages": [
        "dbx-tools-core",
        "dbx-tools-google",
        "dbx-tools-lakebase-proxy",
        "dbx-tools-model",
        "dbx-tools-model-proxy"
      ],
      "binaries": [
        "dbx-lakebase-proxy",
        "dbx-model-proxy",
        "dbx-model-proxy-tray"
      ],
      "features": [
        "dbx-tools-core/uniffi-bindgen",
        "dbx-tools-google/uniffi-bindgen",
        "dbx-tools-model-proxy/tray",
        "dbx-tools-model/uniffi-bindgen"
      ],
      "localFeatures": [
        "dbx-tools-google/local-cross"
      ]
    },
    {
      "runner": "ubuntu-24.04-arm",
      "cargo": "aarch64-unknown-linux-gnu",
      "node": "linux-arm64-gnu",
      "python": "manylinux_2_39_aarch64",
