{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(bun --eval \"console.log(process.env.PATH)\")"
  },
  "tasks": {
    "appkit:deploy": {
      "name": "appkit:deploy",
      "description": "Deploy the AppKit application from an npm-compatible source snapshot",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/appkit-deploy.ts",
            "--directory",
            "packages/demo"
          ],
          "receiveArgs": true
        }
      ]
    },
    "appkit:sync": {
      "name": "appkit:sync",
      "description": "Synchronize installed AppKit plugin metadata",
      "steps": [
        {
          "exec": "appkit plugin sync --write --silent"
        }
      ],
      "cwd": "packages/demo"
    },
    "appkit:typegen": {
      "name": "appkit:typegen",
      "description": "Generate AppKit client declarations",
      "steps": [
        {
          "exec": "appkit generate-types"
        }
      ],
      "cwd": "packages/demo"
    },
    "barrels": {
      "name": "barrels",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/barrels.ts"
          ]
        }
      ]
    },
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Increment VERSION and synchronize generated workspace versions",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/bump.ts"
          ],
          "receiveArgs": true
        },
        {
          "exec": "bun docs/scripts/generate-agent-skill.mjs"
        }
      ]
    },
    "bun-lockfile": {
      "name": "bun-lockfile",
      "description": "Rewrite private npm registry tarball URLs in bun.lock",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/bun-lockfile.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
    "check": {
      "name": "check",
      "description": "Validate the generated workspace with Bun",
      "steps": [
        {
          "spawn": "build"
        }
      ]
    },
    "clean": {
      "name": "clean",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/clean.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)",
        "HEAD_COMMIT": "$(git rev-parse --short HEAD)"
      },
      "steps": [
        {
          "exec": "git checkout -B \"scratch-$HEAD_COMMIT\"",
          "name": "save current HEAD in a \"scratch-<commit>\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under a \"scratch-<commit>\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "execArgs": [
            "bunx",
            "tsc",
            "--build",
            "tsconfig.json",
            "packages/js/cli/args/tsconfig.json",
            "packages/js/cli/dbx-tools/tsconfig.json",
            "packages/js/cli/service/tsconfig.json",
            "packages/js/node/appkit/tsconfig.json",
            "packages/js/node/appkit-generator/tsconfig.json",
            "packages/js/node/appkit-lakebox/tsconfig.json",
            "packages/js/node/appkit-mastra/tsconfig.json",
            "packages/js/node/appkit-memory/tsconfig.json",
            "packages/js/node/appkit-web-search/tsconfig.json",
            "packages/js/node/auth/tsconfig.json",
            "packages/js/node/auth-gate/tsconfig.json",
            "packages/js/node/cache/tsconfig.json",
            "packages/js/node/core/tsconfig.json",
            "packages/js/node/databricks/tsconfig.json",
            "packages/js/node/databricks-zerobus/tsconfig.json",
            "packages/js/node/email/tsconfig.json",
            "packages/js/node/fs/tsconfig.json",
            "packages/js/node/genie/tsconfig.json",
            "packages/js/node/lakebase/tsconfig.json",
            "packages/js/node/lakebox/tsconfig.json",
            "packages/js/node/model/tsconfig.json",
            "packages/js/node/model-protocol/tsconfig.json",
            "packages/js/node/path/tsconfig.json",
            "packages/js/node/postgres/tsconfig.json",
            "packages/js/node/search/tsconfig.json",
            "packages/js/shared/appkit/tsconfig.json",
            "packages/js/shared/auth/tsconfig.json",
            "packages/js/shared/core/tsconfig.json",
            "packages/js/shared/email/tsconfig.json",
            "packages/js/shared/email-template/tsconfig.json",
            "packages/js/shared/fs/tsconfig.json",
            "packages/js/shared/generator/tsconfig.json",
            "packages/js/shared/genie/tsconfig.json",
            "packages/js/shared/genie-code/tsconfig.json",
            "packages/js/shared/graphiti/tsconfig.json",
            "packages/js/shared/lakebox/tsconfig.json",
            "packages/js/shared/mastra/tsconfig.json",
            "packages/js/shared/model/tsconfig.json",
            "packages/js/shared/model-gateway/tsconfig.json",
            "packages/js/shared/search/tsconfig.json",
            "packages/js/ui/lakebox/tsconfig.json",
            "packages/js/ui/mastra/tsconfig.json"
          ]
        },
        {
          "execArgs": [
            "bun",
            "run",
            "pre-compile"
          ],
          "cwd": "packages/demo"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "compile"
          ],
          "cwd": "packages/demo"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "post-compile"
          ],
          "cwd": "packages/demo"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "pre-compile"
          ],
          "cwd": "packages/js/node/appkit-model-gateway"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "compile"
          ],
          "cwd": "packages/js/node/appkit-model-gateway"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "post-compile"
          ],
          "cwd": "packages/js/node/appkit-model-gateway"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "pre-compile"
          ],
          "cwd": "packages/js/node/tunnel"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "compile"
          ],
          "cwd": "packages/js/node/tunnel"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "post-compile"
          ],
          "cwd": "packages/js/node/tunnel"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "pre-compile"
          ],
          "cwd": "packages/js/ui/appkit"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "compile"
          ],
          "cwd": "packages/js/ui/appkit"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "post-compile"
          ],
          "cwd": "packages/js/ui/appkit"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "pre-compile"
          ],
          "cwd": "projen"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "compile"
          ],
          "cwd": "projen"
        },
        {
          "execArgs": [
            "bun",
            "run",
            "post-compile"
          ],
          "cwd": "projen"
        }
      ]
    },
    "dbx": {
      "name": "dbx",
      "steps": [
        {
          "exec": "bun packages/js/cli/dbx-tools/bin/dbx-tools.ts",
          "receiveArgs": true
        }
      ]
    },
    "dbx-tools": {
      "name": "dbx-tools",
      "steps": [
        {
          "exec": "bun packages/js/cli/dbx-tools/bin/dbx-tools.ts",
          "receiveArgs": true
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "bun .projenrc.ts"
        }
      ]
    },
    "demo": {
      "name": "demo",
      "description": "Run the local AppKit demo with Vite HMR on the AppKit server port",
      "env": {
        "NODE_ENV": "development",
        "BUN_CONFIG_ELIDE_LINES": "0"
      },
      "steps": [
        {
          "exec": "bun scripts/run-demo.ts",
          "receiveArgs": true
        }
      ]
    },
    "demo:deploy": {
      "name": "demo:deploy",
      "description": "Stage local artifacts and deploy the AppKit demo to its configured workspace",
      "steps": [
        {
          "exec": "bun scripts/demo-deploy.ts",
          "receiveArgs": true
        }
      ]
    },
    "deploy": {
      "name": "deploy",
      "description": "Validate with Bun and deploy the AppKit application",
      "steps": [
        {
          "spawn": "check"
        },
        {
          "spawn": "appkit:deploy"
        }
      ]
    },
    "dev": {
      "name": "dev",
      "description": "Run the AppKit server in development mode",
      "env": {
        "NODE_ENV": "development"
      },
      "steps": [
        {
          "exec": "bun --watch server/server.ts",
          "receiveArgs": true
        }
      ],
      "cwd": "packages/demo"
    },
    "dev:watch": {
      "name": "dev:watch",
      "description": "Restart a development command after watched changes settle",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/dev-watch.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
    "docs:check-readmes": {
      "name": "docs:check-readmes",
      "description": "Validate and generate documentation from package READMEs",
      "steps": [
        {
          "exec": "bun docs/scripts/sync-cli-readmes.mjs --check"
        },
        {
          "exec": "bun docs/scripts/sync-readmes.mjs"
        },
        {
          "exec": "bun docs/scripts/check-generated-links.mjs --allow-api-stubs"
        },
        {
          "exec": "bun docs/scripts/generate-agent-skill.mjs --check"
        }
      ]
    },
    "docs:check-source": {
      "name": "docs:check-source",
      "description": "Reject new undocumented public TypeScript exports",
      "steps": [
        {
          "exec": "bun docs/scripts/check-source-docs.mjs"
        }
      ]
    },
    "docs:cli": {
      "name": "docs:cli",
      "description": "Update package README command references from their CLI parsers",
      "steps": [
        {
          "exec": "bun docs/scripts/sync-cli-readmes.mjs"
        }
      ]
    },
    "docs:link-check": {
      "name": "docs:link-check",
      "description": "Validate generated Markdown routes and fragments without building HTML",
      "steps": [
        {
          "exec": "bun docs/scripts/sync-readmes.mjs"
        },
        {
          "exec": "bun docs/scripts/check-generated-links.mjs --allow-api-stubs"
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "exec": "eslint --ext .ts,.tsx --no-error-on-unmatched-pattern packages/js/shared packages/js/cli",
          "receiveArgs": true
        },
        {
          "exec": "eslint --ext .ts,.tsx --no-error-on-unmatched-pattern packages/js/node",
          "receiveArgs": true
        },
        {
          "exec": "eslint --ext .ts,.tsx --no-error-on-unmatched-pattern packages/js/ui packages/demo projen",
          "receiveArgs": true
        }
      ]
    },
    "eslint:fix": {
      "name": "eslint:fix",
      "description": "Fix ESLint issues across the codebase",
      "steps": [
        {
          "exec": "bun run eslint -- --fix"
        }
      ]
    },
    "format": {
      "name": "format",
      "steps": [
        {
          "exec": "prettier . --write",
          "receiveArgs": true
        }
      ]
    },
    "graphiti:python-sync": {
      "name": "graphiti:python-sync",
      "description": "Synchronize generated Git sources for dbx-tools-graphiti",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/python-sync.ts",
            "--project",
            "packages/py/graphiti"
          ]
        }
      ]
    },
    "graphiti:python-sync:check": {
      "name": "graphiti:python-sync:check",
      "description": "Verify generated Git sources for dbx-tools-graphiti",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/python-sync.ts",
            "--project",
            "packages/py/graphiti",
            "--check"
          ]
        }
      ]
    },
    "graphiti:smoke:embedded": {
      "name": "graphiti:smoke:embedded",
      "description": "Smoke-test the embedded PostGraph driver and restart persistence",
      "steps": [
        {
          "exec": "cd packages/py/graphiti && uv run --extra dev python smoke/postgraph_restart.py"
        }
      ]
    },
    "graphiti:smoke:mastra": {
      "name": "graphiti:smoke:mastra",
      "description": "Smoke-test the memory plugin through its lazy Graphiti fallback",
      "steps": [
        {
          "exec": "bun packages/js/node/appkit-memory/smoke/mastra-tool.ts",
          "receiveArgs": true
        }
      ]
    },
    "graphiti:sync:verify-tag": {
      "name": "graphiti:sync:verify-tag",
      "description": "Verify the Graphiti sync commit matches its release tag",
      "steps": [
        {
          "exec": "bun -e 'const expected = \"eaa4128681bc53487138a4bbc22d58336ebe70d2\"; const result = Bun.spawnSync([\"git\", \"ls-remote\", \"https://github.com/getzep/graphiti.git\", \"refs/tags/v0.30.2\"]); if (result.exitCode !== 0) throw new Error(result.stderr.toString()); const actual = result.stdout.toString().trim().split(/\\s+/)[0]; if (actual !== expected) throw new Error(`Graphiti tag resolved to ${actual}, expected ${expected}`);'"
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "bun scripts/check-bun.ts"
        },
        {
          "exec": "bun install"
        },
        {
          "spawn": "bun-lockfile"
        }
      ],
      "condition": "bun -e \"process.exit(process.env.DBX_TOOLS_RELEASE_INSTALL === 'never' ? 1 : 0)\""
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "bun scripts/check-bun.ts"
        },
        {
          "exec": "bun install --frozen-lockfile"
        }
      ],
      "condition": "bun -e \"process.exit(process.env.DBX_TOOLS_RELEASE_INSTALL === 'never' ? 1 : 0)\""
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package"
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation",
      "steps": [
        {
          "spawn": "python-node-runtime"
        },
        {
          "spawn": "python-node-bindings"
        },
        {
          "spawn": "graphiti:python-sync"
        }
      ]
    },
    "py:build": {
      "name": "py:build",
      "description": "Build every Python workspace package",
      "steps": [
        {
          "exec": "uv build --all-packages"
        }
      ]
    },
    "py:format": {
      "name": "py:format",
      "description": "Format Python workspace packages",
      "steps": [
        {
          "exec": "uv run ruff format packages/py"
        }
      ]
    },
    "py:lint": {
      "name": "py:lint",
      "description": "Lint Python workspace packages",
      "steps": [
        {
          "exec": "uv run ruff check packages/py"
        },
        {
          "exec": "uv run ruff format --check packages/py"
        }
      ]
    },
    "py:sync": {
      "name": "py:sync",
      "description": "Resolve and install every Python workspace package and optional extra",
      "steps": [
        {
          "exec": "uv sync --all-packages --all-extras"
        }
      ]
    },
    "py:test": {
      "name": "py:test",
      "description": "Run Python workspace tests",
      "steps": [
        {
          "spawn": "py:sync"
        },
        {
          "exec": "uv run --no-sync pytest"
        }
      ]
    },
    "pypiTrustedPublisherInstructions": {
      "name": "pypiTrustedPublisherInstructions",
      "description": "Print system-browser instructions for PyPI trusted publishers",
      "steps": [
        {
          "exec": "bun .projen/pypi-trusted-publisher-instructions.mjs",
          "receiveArgs": true
        }
      ]
    },
    "python-node-bindings": {
      "name": "python-node-bindings",
      "description": "Generate every configured Python Node binding",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/python-node-bindings.ts"
          ]
        }
      ]
    },
    "python-node-bindings:check": {
      "name": "python-node-bindings:check",
      "description": "Verify every configured Python Node binding is current",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/python-node-bindings.ts",
            "--check"
          ]
        }
      ]
    },
    "python-node-runtime": {
      "name": "python-node-runtime",
      "description": "Build the shared PythonMonkey Node runtime",
      "steps": [
        {
          "execArgs": [
            "bun",
            "packages/py/node-runtime/build-runtime.ts"
          ]
        }
      ]
    },
    "python-node-runtime:check": {
      "name": "python-node-runtime:check",
      "description": "Verify the shared PythonMonkey Node runtime is current",
      "steps": [
        {
          "execArgs": [
            "bun",
            "packages/py/node-runtime/build-runtime.ts",
            "--check"
          ]
        }
      ]
    },
    "release": {
      "name": "release",
      "description": "Run bump, commit it, and push an annotated release tag",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/release.ts",
            "--prefix",
            "v",
            "--branch",
            "main",
            "--python-root",
            "packages/py",
            "--validate",
            "test",
            "--validate",
            "docs:check-source",
            "--validate",
            "docs:check-readmes"
          ],
          "receiveArgs": true
        }
      ]
    },
    "shared-core:usage": {
      "name": "shared-core:usage",
      "description": "Report shared-core runtime export usage by caller kind",
      "steps": [
        {
          "exec": "bun projen/tasks/shared-core-usage.ts"
        }
      ]
    },
    "slop:review": {
      "name": "slop:review",
      "description": "Review repository code while honoring generated gitignore exclusions",
      "steps": [
        {
          "exec": "slop-detector review . --format json --config .slopconfig.yaml",
          "receiveArgs": true
        }
      ]
    },
    "start": {
      "name": "start",
      "description": "Run the AppKit server in production mode",
      "env": {
        "NODE_ENV": "production"
      },
      "steps": [
        {
          "exec": "bun server/server.ts",
          "receiveArgs": true
        }
      ],
      "cwd": "packages/demo"
    },
    "sync": {
      "name": "sync",
      "description": "Synthesize once or keep generated sources current with --watch",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/sync.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "spawn": "eslint"
        },
        {
          "spawn": "python-node-runtime:check"
        },
        {
          "spawn": "python-node-bindings:check"
        },
        {
          "spawn": "graphiti:python-sync:check"
        },
        {
          "spawn": "py:lint"
        },
        {
          "spawn": "test:all"
        }
      ]
    },
    "test:all": {
      "name": "test:all",
      "description": "Run all JavaScript, TypeScript, and Python tests",
      "steps": [
        {
          "spawn": "test:unit"
        },
        {
          "spawn": "test:integration"
        },
        {
          "spawn": "py:test"
        }
      ]
    },
    "test:changed": {
      "name": "test:changed",
      "description": "Run tests for changed packages and their dependents",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/test-workspace.ts",
            "changed"
          ],
          "receiveArgs": true
        }
      ]
    },
    "test:focused": {
      "name": "test:focused",
      "description": "Run tests for explicit workspace packages or paths",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/@dbx-tools/projen/tasks/test-workspace.ts",
            "focused"
          ],
          "receiveArgs": true
        }
      ]
    },
    "test:integration": {
      "name": "test:integration",
      "description": "Run integration and packed-consumer tests",
      "steps": [
        {
          "execArgs": [
            "bun",
            "test",
