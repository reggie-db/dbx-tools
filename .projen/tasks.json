{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(bun --eval \"console.log(process.env.PATH)\")"
  },
  "tasks": {
    "auth:cli-assets": {
      "name": "auth:cli-assets",
      "description": "Refresh the pinned Databricks CLI release asset manifest",
      "steps": [
        {
          "exec": "bun projen/tasks/databricks-cli-assets.ts"
        }
      ]
    },
    "auth:cli-assets:check": {
      "name": "auth:cli-assets:check",
      "description": "Verify the pinned Databricks CLI release asset manifest",
      "steps": [
        {
          "exec": "bun projen/tasks/databricks-cli-assets.ts --check"
        }
      ]
    },
    "barrels": {
      "name": "barrels",
      "steps": [
        {
          "exec": "bun node_modules/@dbx-tools/projen/tasks/barrels.ts"
        }
      ]
    },
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Increment VERSION and synchronize generated workspace versions",
      "steps": [
        {
          "exec": "bun node_modules/@dbx-tools/projen/tasks/bump.ts",
          "receiveArgs": true
        }
      ]
    },
    "clean": {
      "name": "clean",
      "steps": [
        {
          "exec": "bun node_modules/@dbx-tools/projen/tasks/clean.ts",
          "receiveArgs": true
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "bun node_modules/@dbx-tools/projen/tasks/compile-workspace.ts"
        }
      ]
    },
    "dbx": {
      "name": "dbx",
      "steps": [
        {
          "exec": "bun packages/js/cli/dbx-tools/bin/dbx-tools.ts",
          "receiveArgs": true
        }
      ]
    },
    "dbx-tools": {
      "name": "dbx-tools",
      "steps": [
        {
          "exec": "bun packages/js/cli/dbx-tools/bin/dbx-tools.ts",
          "receiveArgs": true
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "bun .projenrc.ts"
        }
      ]
    },
    "demo": {
      "name": "demo",
      "description": "Run the local demo server, client, and Python bus emitter",
      "env": {
        "NODE_ENV": "development",
        "BUN_CONFIG_ELIDE_LINES": "0"
      },
      "steps": [
        {
          "exec": "bun scripts/run-demo.ts"
        }
      ]
    },
    "demo:emitter": {
      "name": "demo:emitter",
      "description": "Emit local Python hello-world messages onto the demo bus",
      "steps": [
        {
          "exec": "bun scripts/run-demo.ts --emitter-only"
        }
      ]
    },
    "docs:check-readmes": {
      "name": "docs:check-readmes",
      "description": "Validate and generate documentation from package READMEs",
      "steps": [
        {
          "exec": "bun docs/scripts/sync-readmes.mjs"
        }
      ]
    },
    "docs:check-source": {
      "name": "docs:check-source",
      "description": "Reject new undocumented public TypeScript exports",
      "steps": [
        {
          "exec": "bun docs/scripts/check-source-docs.mjs"
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "execArgs": [
            "eslint",
            "--ext",
            ".ts,.tsx",
            "--no-error-on-unmatched-pattern",
            "$@",
            "packages/js",
            "packages/test",
            "packages/example",
            "projen"
          ],
          "receiveArgs": true
        }
      ]
    },
    "eslint:fix": {
      "name": "eslint:fix",
      "description": "Fix ESLint issues across the codebase",
      "steps": [
        {
          "exec": "bun run eslint -- --fix"
        }
      ]
    },
    "format": {
      "name": "format",
      "steps": [
        {
          "exec": "prettier . --write",
          "receiveArgs": true
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "bun install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "bun install --frozen-lockfile"
        }
      ]
    },
    "model-proxy:python-runtime": {
      "name": "model-proxy:python-runtime",
      "description": "Generate Node bindings for Python package model-proxy",
      "steps": [
        {
          "exec": "bun node_modules/@dbx-tools/projen/tasks/python-node-bindings.ts --project packages/py/model-proxy"
        }
      ]
    },
    "model-proxy:python-runtime:check": {
      "name": "model-proxy:python-runtime:check",
      "description": "Verify generated Node bindings for Python package model-proxy",
      "steps": [
        {
          "exec": "bun node_modules/@dbx-tools/projen/tasks/python-node-bindings.ts --project packages/py/model-proxy --check"
        }
      ]
    },
    "model-proxy:python-runtime:watch": {
      "name": "model-proxy:python-runtime:watch",
      "description": "Regenerate Node bindings for Python package model-proxy on changes",
      "steps": [
        {
          "exec": "bun node_modules/@dbx-tools/projen/tasks/python-node-bindings-watch.ts --project packages/py/model-proxy"
        }
      ]
    },
    "model:contracts": {
      "name": "model:contracts",
      "description": "Generate browser-safe Zod model schemas from TypeScript contracts",
      "steps": [
        {
          "exec": "bunx ts-to-zod packages/js/shared/model/src/contracts.ts packages/js/shared/model/src/generated/_schemas.ts --keepComments"
        }
      ]
    },
    "model:metadata": {
      "name": "model:metadata",
      "description": "Refresh Node-owned model retirement, capability, and rate-limit snapshots",
      "steps": [
        {
          "exec": "bun packages/js/node/model/scripts/generate-metadata.ts"
        }
      ]
    },
    "openapi": {
      "name": "openapi",
      "steps": [
        {
          "exec": "bun node_modules/@dbx-tools/projen/tasks/openapi.ts"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package"
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation",
      "steps": [
        {
          "spawn": "model:contracts"
        }
      ]
    },
    "py:build": {
      "name": "py:build",
      "description": "Build every Python workspace package",
      "steps": [
        {
          "exec": "uv build --all-packages"
        }
      ]
    },
    "py:format": {
      "name": "py:format",
      "description": "Format Python workspace packages",
      "steps": [
        {
          "exec": "uv run ruff format packages/py packages/example/python packages/example/notebooks"
        }
      ]
    },
    "py:lint": {
      "name": "py:lint",
      "description": "Lint Python workspace packages",
      "steps": [
        {
          "exec": "uv run ruff check packages/py packages/example/python packages/example/notebooks"
        }
      ]
    },
    "py:sync": {
      "name": "py:sync",
      "description": "Resolve and install every Python workspace package",
      "steps": [
        {
          "exec": "uv sync --all-packages"
        }
      ]
    },
    "py:test": {
      "name": "py:test",
      "description": "Run Python workspace tests",
      "steps": [
        {
          "exec": "uv run pytest"
        }
      ]
    },
    "pypiTrustedPublisherInstructions": {
      "name": "pypiTrustedPublisherInstructions",
      "description": "Print system-browser instructions for PyPI trusted publishers",
      "steps": [
        {
          "exec": "node .projen/pypi-trusted-publisher-instructions.mjs",
          "receiveArgs": true
        }
      ]
    },
    "release": {
      "name": "release",
      "description": "Run bump, commit it, and push an annotated release tag",
      "steps": [
        {
          "exec": "bun node_modules/@dbx-tools/projen/tasks/release.ts --prefix v --branch main",
          "receiveArgs": true
        }
      ]
    },
    "sync": {
      "name": "sync",
      "steps": [
        {
          "exec": "bun node_modules/@dbx-tools/projen/tasks/sync.ts",
          "receiveArgs": true
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "spawn": "eslint"
        },
        {
          "spawn": "test:installer"
        },
        {
          "spawn": "model-proxy:python-runtime:check"
        },
        {
          "spawn": "auth:cli-assets:check"
        },
        {
          "exec": "bun run --filter '*' test"
        }
      ]
    },
    "test:installer": {
      "name": "test:installer",
      "description": "Test the standalone mise installer (set RUN_DOCKER_INSTALL_TESTS=1 for container coverage)",
      "steps": [
        {
          "exec": "bun test scripts/install.test.ts"
        }
      ]
    },
    "version:check": {
      "name": "version:check",
      "description": "Verify every package and generated barrel matches VERSION",
      "steps": [
        {
          "exec": "bun node_modules/@dbx-tools/projen/tasks/version-check.ts"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"bunx projen\"."
}
